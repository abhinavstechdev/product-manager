# ================================================================
# APEX AI INVENTORY & ORDER MANAGEMENT PLATFORM
# Environment Variables Configuration Template
# ================================================================

# Primary Database URL (Managed Neon PostgreSQL or standard PostgreSQL)
# Format: postgresql://[user]:[password]@[neon-hostname]/[database]?sslmode=require
DATABASE_URL="postgresql://neondb_owner:your_password@ep-your-database-pooler.neon.tech/neondb?sslmode=require"

# Website Session & Auth Secret (32+ character random string)
AUTH_SECRET="your_32_character_random_auth_secret_key"

# Application Base URL (Domain on Vercel or localhost)
APP_BASE_URL="http://localhost:3000"

# MCP Server Endpoint Configuration
MCP_SERVER_URL="http://localhost:3000/api/mcp"
