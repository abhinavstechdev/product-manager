# ================================================================
# APEX AI INVENTORY & ORDER MANAGEMENT PLATFORM
# Environment Variables Configuration Template
# ================================================================

# [REQUIRED] Primary Database URL (Managed Neon PostgreSQL or standard PostgreSQL)
# Format: postgresql://[user]:[password]@[neon-hostname]/[database]?sslmode=require
# NOTE: Schema migrations run AUTOMATICALLY on Vercel deployment during build!
DATABASE_URL="postgresql://neondb_owner:your_password@ep-your-database-pooler.neon.tech/neondb?sslmode=require"

# [REQUIRED] Website Session & Auth Secret (32+ character random string)
AUTH_SECRET="your_32_character_random_auth_secret_key"

# [OPTIONAL] Application Base URL
# If omitted on Vercel, this is AUTOMATICALLY detected via VERCEL_PROJECT_PRODUCTION_URL
# and dynamic request headers (supports custom domains & preview deployments).
# Set only if you wish to enforce a fixed URL override.
APP_BASE_URL="http://localhost:3000"

# [OPTIONAL] MCP Server Endpoint Configuration
# If omitted, defaults automatically to: ${APP_BASE_URL}/api/mcp
MCP_SERVER_URL="http://localhost:3000/api/mcp"
